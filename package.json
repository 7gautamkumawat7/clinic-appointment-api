{
  "name": "clinic-booking",
  "version": "1.0.0",
  "description": "Clinic appointment booking API with high concurrency protection",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:dist": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
